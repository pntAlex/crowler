# Réglages de la stack Compose. Copiez ce fichier en `.env` pour les changer :
# `docker compose` le lit tout seul.

# Port publié sur l'hôte. Le conteneur, lui, écoute toujours sur 3000.
CROWLER_PORT=3000

# 0 autorise les cibles sur réseau privé (localhost, 10.x, 192.168.x…).
# À ne lever que sur un réseau maîtrisé : le crawler suit les liens trouvés.
BLOCK_PRIVATE_IPS=1

# Audits conservés dans le volume ; au-delà, les plus anciens sont supprimés.
MAX_SESSIONS=50

# Secondes minimum entre deux déclenchements d'un même preset par webhook.
WEBHOOK_MIN_INTERVAL=60

DOMAINS=TO_DEFINE.com

# Network informations
NETWORK_EXTERNAL=false
NETWORK_NAME=crowler-network
